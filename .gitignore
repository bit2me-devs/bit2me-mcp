# Node.js & TypeScript project
node_modules/
.pnpm-store/

# Build output
/dist/
/build/

# TypeScript cache
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example
.env.local
.env.*.local
.envrc

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.iml

# Cursor / Claude — rules y skills son locales, no se versionan
.cursor/
.claude/

# Código / binarios de feat/go-migration. El árbol `go/` vive en esa rama;
# en main solo quedarían artefactos sueltos (p. ej. go/bin/) al cambiar de rama.
/go/

# Test coverage
coverage/

# Test credentials (contains secrets)
test-credentials.js

# Miscellaneous
*.tgz
*.zip
*.pem
*.key

# Temporary files
tmp/
*.tmp

# Documentación interna y temporal (uso del equipo, no se versiona).
# Excepciones: docs/stack/ (fuente de verdad de tooling/stack) y docs/adr/
# (Architectural Decision Records) SÍ se versionan.
# Nota: usamos docs/* (no docs/) para que git pueda re-incluir las excepciones.
docs/*
!docs/README.md
!docs/stack/
!docs/adr/
!docs/done-tasks/
!docs/done-tasks/**
!docs/CHANGELOG.md

# Assets locales (imágenes temporales)
assets/
