{
    "name": "@bit2me/mcp-server",
    "version": "4.1.4",
    "description": "Bit2Me MCP Server",
    "type": "module",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        }
    },
    "files": [
        "build",
        "data",
        "README.md",
        "LICENSE"
    ],
    "packageManager": "pnpm@10.0.0",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "bin": {
        "bit2me-mcp-server": "./build/index.js",
        "bit2me-mcp-http": "./build/index-http.js"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:llms": "node scripts/generate-llms.js",
        "build:docs": "node scripts/generate-tools-docs.js",
        "prepublishOnly": "pnpm run validate && pnpm run build",
        "start": "node build/index.js",
        "dev": "pnpm dlx @modelcontextprotocol/inspector node build/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "RUN_E2E=true vitest run tests/e2e",
        "test:e2e:watch": "RUN_E2E=true vitest tests/e2e",
        "test:fuzz": "vitest run tests/fuzz.test.ts",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/**/*.ts tests/**/*.ts --fix",
        "lint:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "eslint": "eslint",
        "eslint:legacy": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "eslint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "prettier": "prettier --write .",
        "audit": "node scripts/audit-high.js",
        "knip": "knip",
        "secret-scan": "bash -c 'if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --verbose --redact; else echo \"ERROR: gitleaks is required for the pre-commit secret scan. Install it from https://github.com/gitleaks/gitleaks (e.g. \\`brew install gitleaks\\` or \\`apt install gitleaks\\`).\" >&2; exit 1; fi' --",
        "clean": "rm -rf build coverage",
        "publint": "publint",
        "check-file-size": "bash scripts/check-file-size.sh",
        "check-file-size-strict": "bash scripts/check-file-size.sh --strict",
        "validate": "pnpm run typecheck && pnpm run lint && pnpm run publint && pnpm test && bash scripts/check-file-size.sh --strict",
        "prepare": "husky"
    },
    "keywords": [
        "mcp",
        "bit2me",
        "server"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bit2me-devs/bit2me-mcp.git"
    },
    "homepage": "https://mcp.bit2me.com",
    "author": "Bit2Me",
    "license": "MIT",
    "dependencies": {
        "@fastify/rate-limit": "^11.2.1",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "axios": "^1.20.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^18.0.8",
        "fastify": "^5.12.7",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.4",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@types/node": "^26.6.5",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.13.0",
        "eslint-plugin-security": "^4.2.0",
        "fast-check": "^4.10.2",
        "globals": "^17.13.0",
        "html-minifier-terser": "^7.2.0",
        "husky": "^9.1.7",
        "knip": "^6.41.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "semantic-release": "^25.0.9",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "8.3.5",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "overrides": {
            "qs": "^6.15.3",
            "hono": "^4.13.13",
            "form-data": "^4.0.6",
            "body-parser": "^2.3.0",
            "fast-uri": "^3.1.8",
            "find-my-way": "^9.9.0",
            "ip-address": "^10.7.4",
            "proxy-addr": "^2.0.8",
            "@hono/node-server": "^1.19.17",
            "undici@6": "6.29.1",
            "undici@7": "7.30.1",
            "brace-expansion@5": "5.0.12",
            "handlebars": "^4.7.10",
            "source-map-js": "^1.2.2",
            "js-yaml@4": "4.3.2",
            "esbuild": "^0.28.1"
        }
    },
    "lint-staged": {
        "*": [
            "pnpm run secret-scan"
        ],
        "package.json": [
            "pnpm run audit"
        ],
        "pnpm-lock.yaml": [
            "pnpm run audit"
        ],
        "*.ts": [
            "pnpm exec eslint --fix",
            "prettier --write",
            "vitest related --run"
        ],
        "*.{css,html,json,md}": [
            "prettier --write"
        ]
    }
}
